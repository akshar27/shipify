# Required
DATABASE_URL="postgresql://USER@localhost:5432/shipify_dev"
JWT_SECRET="change-me-to-at-least-32-random-characters"
PORT=5050
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000   # comma-separated browser origins allowed to call the API
TRUST_PROXY=0                        # number of reverse proxies in front (nginx = 1) so rate limits see real client IPs

# Optional: each feature falls back or reports "not configured" when its keys are missing
SMTP_EMAIL=            # with SMTP_PASS: send real mail; without: links are printed to the server console
SMTP_PASS=
AWS_BUCKET_NAME=       # set (with the AWS_* keys below) to upload to S3; unset: files saved under backend/uploads/
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
STRIPE_SECRET_KEY=     # unset: /api/payments answers 503
STRIPE_WEBHOOK_SECRET= # from `stripe listen` / the dashboard endpoint; required to mark deliveries paid
DELIVERY_FEE_CENTS=1000
PAYMENT_CURRENCY=usd
MAX_ITEM_VALUE_CENTS=20000  # declared-value cap per delivery ($200)
COMPANY_NAME=              # shown on the Terms and Privacy pages
SUPPORT_EMAIL=
AUTO_CONFIRM_HOURS=72      # sender's window to confirm or dispute after delivery; then it auto-confirms
PLATFORM_FEE_PERCENT=20    # platform's cut; the rest is paid to the traveler manually by an admin
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
